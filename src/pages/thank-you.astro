---
import Layout from '../layouts/Layout.astro';
import { SITE } from '../config/site';

const waText = encodeURIComponent("Hi, I just submitted the audit form and wanted to follow up.");

const nextSteps = [
  { label: 'First', body: 'We review what you shared — usually within a few hours.' },
  { label: 'Then', body: "We reach out by WhatsApp or email to confirm details, if we need anything more." },
  { label: 'Finally', body: 'You get a written audit: what\'s wrong with the account and what we\'d change — no pitch attached.' },
];
---

<Layout
  title={`Thank you | ${SITE.name}`}
  description="We've received your enquiry and will be in touch within one business day."
  noindex={true}
  hideFooterCTA
>
  <section class="section thank-you">
    <div class="container thank-you-inner">
      <p class="eyebrow">Got it</p>
      <h1>Thanks — we've got your details.</h1>
      <p class="lede">
        We'll review what you shared and get back to you within <strong>one business day</strong>,
        by WhatsApp or email — whichever you'd rather use.
      </p>

      <div class="thank-you-steps">
        {nextSteps.map(step => (
          <div class="thank-you-step">
            <p class="thank-you-step-label">{step.label}</p>
            <p class="muted">{step.body}</p>
          </div>
        ))}
      </div>

      <div class="thank-you-actions">
        <a href={`https://wa.me/${SITE.whatsapp}?text=${waText}`} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
          Follow up on WhatsApp
        </a>
        <a href="/" class="btn btn-secondary">Back to homepage</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .thank-you { padding-block: 5rem; }
  .thank-you-inner { max-width: 34rem; }
  .thank-you-inner h1 { margin-block: 0.6rem 1rem; }
  .thank-you-inner .lede { max-width: none; margin-bottom: 2.5rem; }

  .thank-you-steps { display: flex; flex-direction: column; margin-bottom: 2.5rem; }
  .thank-you-step {
    display: grid;
    grid-template-columns: 5rem 1fr;
    gap: 1rem;
    padding-block: 1.1rem;
    border-top: 1px solid var(--rule);
  }
  .thank-you-step:last-child { border-bottom: 1px solid var(--rule); }
  .thank-you-step-label {
    font-family: var(--font-display);
    font-weight: 650;
    font-size: var(--fs-sm);
  }

  .thank-you-actions { display: flex; flex-wrap: wrap; gap: 0.85rem; }
</style>
