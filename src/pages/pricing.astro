---
import Layout from '../layouts/Layout.astro';
import CTASection from '../components/ui/CTASection.astro';
import FAQAccordion from '../components/ui/FAQAccordion.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Do you charge a percentage of ad spend or a flat fee?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We offer both. Clients with budgets under ₹1,00,000/month typically prefer the flat retainer for predictability. Higher-spend clients often opt for a percentage model (typically 10–15% of ad spend)."
      }
    },
    {
      "@type": "Question",
      "name": "Are there any lock-in contracts?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. All plans are month-to-month. We ask for 30 days notice to wind down properly, but there are no penalty clauses."
      }
    }
  ]
};

const tiers = [
  {
    name: 'Starter',
    price: '[PLACEHOLDER: ₹X,XXX/mo]',
    adSpend: 'Up to ₹50,000/mo ad spend',
    desc: 'For businesses new to Google Ads or with a focused single campaign.',
    features: [
      'Up to 2 campaigns',
      'Monthly strategy call',
      'Bi-weekly optimisation',
      'Monthly performance report',
      'Conversion tracking setup (one-time add-on)',
      'Email + WhatsApp support',
    ],
    cta: 'Get started',
    highlight: false,
  },
  {
    name: 'Growth',
    price: '[PLACEHOLDER: ₹X,XXX/mo]',
    adSpend: '₹50,000 – ₹2,00,000/mo ad spend',
    desc: 'Our most popular plan — for businesses ready to scale lead volume.',
    features: [
      'Up to 5 campaigns',
      'Weekly optimisation',
      'Monthly strategy call',
      'Fortnightly check-in call',
      'Conversion tracking included',
      'A/B ad copy testing',
      'Competitor analysis',
      'Live reporting dashboard',
      'Priority WhatsApp support',
    ],
    cta: 'Get started',
    highlight: true,
  },
  {
    name: 'Scale',
    price: '[PLACEHOLDER: ₹X,XXX/mo or X% of spend]',
    adSpend: '₹2,00,000+/mo ad spend',
    desc: 'For growth-stage businesses with multiple campaigns and higher complexity.',
    features: [
      'Unlimited campaigns',
      'Daily monitoring',
      'Weekly strategy call',
      'Server-side tracking',
      'Enhanced conversions',
      'Offline conversion import',
      'Shopping / Performance Max included',
      'CRO recommendations',
      'Dedicated account manager',
    ],
    cta: 'Talk to us',
    highlight: false,
  },
];

const faqs = [
  {
    question: "Do you charge a percentage of ad spend or a flat fee?",
    answer: "We offer both. Clients with budgets under ₹1,00,000/month typically prefer the flat retainer for predictability. Higher-spend clients often opt for a percentage model (typically 10–15% of ad spend). See tier details above."
  },
  {
    question: "Are there any lock-in contracts?",
    answer: "No. All plans are month-to-month. We ask for 30 days notice to wind down properly, but there are no lock-in clauses or penalties."
  },
  {
    question: "Is the setup fee separate from the monthly fee?",
    answer: "Yes. A one-time campaign setup / account restructure fee ([PLACEHOLDER: ₹X,XXX]) applies on first engagement. This covers the initial audit, restructure, ad copy, and conversion tracking. It's waived for clients on the Growth or Scale plan after 3 months."
  },
  {
    question: "What's the minimum ad budget you work with?",
    answer: "We recommend a minimum Google Ads budget of ₹25,000/month to generate enough data for meaningful optimisation. Below that, results are possible but slow. We'll be upfront if your budget is unlikely to achieve your goals."
  },
  {
    question: "Can I start with just the audit?",
    answer: "Absolutely. The audit is free and gives you a complete action plan whether you hire us or not. Many clients start there, then move to a management plan once they're confident in our approach."
  },
  {
    question: "What does 'conversion tracking included' mean?",
    answer: "On the Growth and Scale plans, we handle the GTM setup, Google Ads conversion actions, and GA4 linkage as part of the setup process. The one-time setup fee covers this. On the Starter plan, conversion tracking setup is a separate one-time add-on."
  },
];
---

<Layout
  title="Google Ads Management Pricing in India | Clearbid"
  description="Transparent Google Ads management pricing for SMBs in Delhi NCR. Flat retainer and percentage-of-spend models. No lock-in contracts. Packages from ₹[PLACEHOLDER]."
  schema={schema}
>
  <div class="container-site">
    <Breadcrumbs crumbs={[
      { label: 'Home', href: '/' },
      { label: 'Pricing' }
    ]} />
  </div>

  <!-- Hero -->
  <section class="bg-gradient-to-br from-blue-950 to-blue-800 text-white py-16 lg:py-20 text-center">
    <div class="container-site max-w-3xl">
      <h1 class="text-4xl sm:text-5xl font-extrabold mb-6">Pricing & packages</h1>
      <p class="text-lg text-blue-100 mb-4">
        Transparent, tiered pricing in INR. All prices below are placeholders — the owner will set final prices before launch. No lock-in contracts, ever.
      </p>
      <p class="text-orange-300 text-sm font-semibold">
        [PLACEHOLDER — owner must set all ₹ amounts before publishing]
      </p>
    </div>
  </section>

  <!-- Pricing tiers -->
  <section class="py-16 lg:py-20">
    <div class="container-site">
      <div class="grid md:grid-cols-3 gap-8 max-w-5xl mx-auto">
        {tiers.map(tier => (
          <div class={`rounded-2xl border p-8 flex flex-col ${tier.highlight ? 'border-orange-300 bg-orange-50 shadow-lg ring-2 ring-orange-200' : 'border-slate-200 bg-white'}`}>
            {tier.highlight && (
              <span class="bg-orange-500 text-white text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-full self-start mb-4">
                Most popular
              </span>
            )}
            <h2 class="text-2xl font-bold text-blue-900 mb-1">{tier.name}</h2>
            <p class="text-3xl font-extrabold text-blue-900 mb-1">{tier.price}</p>
            <p class="text-sm text-slate-500 mb-3">{tier.adSpend}</p>
            <p class="text-sm text-slate-600 mb-6">{tier.desc}</p>
            <ul class="space-y-2 flex-1 mb-8">
              {tier.features.map(f => (
                <li class="flex items-start gap-2 text-sm text-slate-700">
                  <svg class="w-4 h-4 text-green-500 flex-shrink-0 mt-0.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd"/>
                  </svg>
                  {f}
                </li>
              ))}
            </ul>
            <a
              href="/contact/"
              class={`w-full text-center py-3 rounded-lg font-semibold text-sm transition-all ${tier.highlight ? 'bg-orange-500 hover:bg-orange-600 text-white' : 'border-2 border-blue-900 text-blue-900 hover:bg-blue-900 hover:text-white'}`}
            >
              {tier.cta} →
            </a>
          </div>
        ))}
      </div>

      <!-- Notes -->
      <div class="max-w-3xl mx-auto mt-10 bg-slate-50 rounded-xl p-6 text-sm text-slate-600 space-y-2">
        <p>• All prices above are placeholders — final prices set by the owner before launch.</p>
        <p>• One-time campaign setup / restructure fee: <strong>[PLACEHOLDER: ₹X,XXX]</strong> (waived on Growth+ after 3 months).</p>
        <p>• Google Ads budget is billed directly to your Google account — we never hold your ad spend.</p>
        <p>• Scale plan available as % of ad spend ([PLACEHOLDER: X%]) for budgets above ₹2,00,000/month.</p>
        <p>• All plans include month-to-month terms — no lock-in contracts.</p>
      </div>
    </div>
  </section>

  <FAQAccordion {faqs} heading="Pricing questions" />

  <CTASection heading="Not sure which plan fits?" subtext="Start with a free audit. We'll assess your situation and recommend the right approach — no upsell pressure." />
</Layout>
