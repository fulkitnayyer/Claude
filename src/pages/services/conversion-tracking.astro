---
import Layout from '../../layouts/Layout.astro';
import CTASection from '../../components/ui/CTASection.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
---

<Layout
  title="Google Ads Conversion Tracking Setup | Clearbid"
  description="Server-side conversion tracking, enhanced conversions, and GA4 setup for Google Ads campaigns in Delhi NCR. Know which ads drive real revenue."
>
  <div class="container-site">
    <Breadcrumbs crumbs={[
      { label: 'Home', href: '/' },
      { label: 'Services', href: '/services/' },
      { label: 'Conversion Tracking' }
    ]} />
  </div>

  <section class="bg-gradient-to-br from-blue-950 to-blue-800 text-white py-16 lg:py-20">
    <div class="container-site max-w-3xl">
      <h1 class="text-4xl sm:text-5xl font-extrabold mb-6">Conversion Tracking Setup</h1>
      <p class="text-lg text-blue-100 mb-8">
        Without accurate conversion tracking, you're optimising blind. We set up server-side tagging, enhanced conversions, and GA4 so every lead and sale is attributed correctly — and your bidding algorithms have the data they need.
      </p>
      <a href="/contact/" class="btn-primary inline-flex text-base px-8 py-4">
        Get a Free Tracking Audit
      </a>
    </div>
  </section>

  <section class="py-16 lg:py-20">
    <div class="container-site max-w-4xl">
      <h2 class="text-3xl font-bold text-blue-900 mb-4">Why tracking matters more than ever</h2>
      <p class="text-slate-600 mb-10 text-lg">
        With IOS 14+, cookie restrictions, and increased browser privacy, standard client-side tracking misses 20–40% of conversions. Server-side tracking and enhanced conversions recover this data — giving Google's Smart Bidding the signal it needs to optimise properly.
      </p>

      <div class="grid sm:grid-cols-2 gap-6 mb-12">
        {[
          {
            title: 'Google Tag Manager setup',
            desc: 'Container setup or audit, tag architecture, cross-domain tracking, and trigger configuration.'
          },
          {
            title: 'Google Ads conversion tracking',
            desc: 'Form fills, phone calls, WhatsApp clicks, purchases — every important action tracked and tested.'
          },
          {
            title: 'Enhanced conversions',
            desc: 'First-party data matching for better attribution. Recovers conversions lost to cookie blocking.'
          },
          {
            title: 'GA4 integration',
            desc: 'GA4 property setup, event tracking, audience creation, and Google Ads account linking.'
          },
          {
            title: 'Server-side tagging',
            desc: 'GTM server container on your domain — faster page load, better data quality, reduced ITP impact.'
          },
          {
            title: 'Offline conversion import',
            desc: 'Import CRM data (GCLID-based) so Google Ads sees which clicks actually became customers, not just leads.'
          },
        ].map(item => (
          <div class="bg-slate-50 rounded-xl p-6">
            <h3 class="font-bold text-blue-900 mb-2">{item.title}</h3>
            <p class="text-sm text-slate-600">{item.desc}</p>
          </div>
        ))}
      </div>

      <div class="bg-orange-50 rounded-xl p-6 border border-orange-100">
        <p class="font-semibold text-orange-800 mb-1">One-time tracking setup</p>
        <p class="text-sm text-orange-700">
          [PLACEHOLDER: ₹ amount]. Includes full implementation, testing, and a walkthrough call. See <a href="/pricing/" class="underline">Pricing</a> for details.
        </p>
      </div>
    </div>
  </section>

  <CTASection heading="Is your conversion tracking accurate?" subtext="We'll audit your existing tracking for free and show you what you're missing before we fix it." />
</Layout>

<style>
  .btn-primary { display:inline-flex;align-items:center;justify-content:center;gap:0.5rem;padding:0.75rem 1.5rem;border-radius:0.5rem;background-color:#f97316;color:white;font-weight:600;transition:background-color 0.2s; }
  .btn-primary:hover { background-color:#ea580c; }
</style>
