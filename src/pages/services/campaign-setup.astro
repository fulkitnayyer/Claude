---
import Layout from '../../layouts/Layout.astro';
import CTASection from '../../components/ui/CTASection.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
---

<Layout
  title="Google Ads Campaign Setup for Small Businesses | Clearbid"
  description="Launch new Google Ads campaigns built right from day one. Search, Display, Shopping, and Performance Max for SMBs in Delhi NCR."
>
  <div class="container-site">
    <Breadcrumbs crumbs={[
      { label: 'Home', href: '/' },
      { label: 'Services', href: '/services/' },
      { label: 'Campaign Setup' }
    ]} />
  </div>

  <section class="bg-gradient-to-br from-blue-950 to-blue-800 text-white py-16 lg:py-20">
    <div class="container-site max-w-3xl">
      <h1 class="text-4xl sm:text-5xl font-extrabold mb-6">Google Ads Campaign Setup</h1>
      <p class="text-lg text-blue-100 mb-8">
        New to Google Ads or starting from scratch? We build campaigns structured for performance — the right keywords, match types, ad groups, bid strategy, and conversion tracking from day one.
      </p>
      <a href="/contact/" class="btn-primary inline-flex text-base px-8 py-4">
        Get Started — Free Consultation
      </a>
    </div>
  </section>

  <section class="py-16 lg:py-20">
    <div class="container-site max-w-4xl">
      <h2 class="text-3xl font-bold text-blue-900 mb-8">What's included in campaign setup</h2>
      <div class="grid sm:grid-cols-2 gap-4">
        {[
          'Keyword research and intent mapping',
          'Campaign and ad group architecture',
          'Match type strategy (exact, phrase, broad)',
          'Negative keyword foundation list',
          'Ad copy for each ad group (3+ variants)',
          'Ad extensions setup (sitelinks, callouts, structured snippets, call, location)',
          'Bidding strategy selection and target setting',
          'Conversion tracking setup (via GTM)',
          'Google Analytics 4 linkage',
          'Audience targeting setup',
          'Budget pacing configuration',
          'Campaign launch and initial review call',
        ].map(item => (
          <div class="flex items-start gap-3 p-4 bg-slate-50 rounded-lg">
            <svg class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd"/>
            </svg>
            <span class="text-sm text-slate-700">{item}</span>
          </div>
        ))}
      </div>

      <div class="mt-10 p-6 bg-blue-50 rounded-xl border border-blue-100">
        <p class="text-blue-900 font-semibold mb-2">Campaign types we set up</p>
        <div class="flex flex-wrap gap-3">
          {['Search', 'Display', 'Shopping', 'Performance Max', 'Video (YouTube)'].map(t => (
            <span class="bg-blue-100 text-blue-800 text-sm font-medium px-3 py-1 rounded-full">{t}</span>
          ))}
        </div>
      </div>

      <div class="mt-8 p-6 bg-orange-50 rounded-xl border border-orange-100">
        <p class="text-orange-800 font-semibold mb-1">One-time setup fee</p>
        <p class="text-orange-700 text-sm">
          [PLACEHOLDER: ₹ amount] for a full campaign setup. See our <a href="/pricing/" class="underline">Pricing page</a> for details.
          Most clients then move to an ongoing management plan.
        </p>
      </div>
    </div>
  </section>

  <CTASection heading="Start advertising the right way" subtext="Get a free consultation call before we build anything — so the campaigns are built around your business goals, not guesswork." />
</Layout>

<style>
  .btn-primary { display:inline-flex;align-items:center;justify-content:center;gap:0.5rem;padding:0.75rem 1.5rem;border-radius:0.5rem;background-color:#f97316;color:white;font-weight:600;transition:background-color 0.2s; }
  .btn-primary:hover { background-color:#ea580c; }
</style>
