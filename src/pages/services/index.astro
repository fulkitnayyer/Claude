---
import Layout from '../../layouts/Layout.astro';
import CTASection from '../../components/ui/CTASection.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';

const services = [
  {
    title: 'Google Ads Management',
    desc: 'Full ongoing management — strategy, campaign optimisation, bid management, reporting. Weekly refinements, dedicated manager.',
    href: '/services/google-ads-management/',
    icon: '⚙️',
    badge: 'Most popular',
  },
  {
    title: 'Google Ads Audit',
    desc: 'In-depth review of your existing campaigns. Identify wasted spend, keyword gaps, quality score issues, and quick wins.',
    href: '/services/google-ads-audit/',
    icon: '🔎',
    badge: 'Best starting point',
  },
  {
    title: 'Campaign Setup',
    desc: 'Launch new Search, Display, Shopping, or Performance Max campaigns architected for performance from day one.',
    href: '/services/campaign-setup/',
    icon: '🚀',
    badge: null,
  },
  {
    title: 'Conversion Tracking Setup',
    desc: 'Server-side tracking, enhanced conversions, GA4, and Google Tag Manager — so you always know which ads drive revenue.',
    href: '/services/conversion-tracking/',
    icon: '📊',
    badge: null,
  },
];

const processSteps = [
  { step: '01', title: 'Discovery call', desc: 'We learn about your business, goals, and current ad setup (or absence of one).' },
  { step: '02', title: 'Audit & strategy', desc: 'We audit your account or market, then build a tailored strategy and campaign structure.' },
  { step: '03', title: 'Launch & track', desc: 'Campaigns go live with full conversion tracking wired up from the start.' },
  { step: '04', title: 'Optimise monthly', desc: 'Weekly refinements, A/B testing, and a plain-English monthly report — every month.' },
];
---

<Layout
  title="Google Ads Services for SMBs | Clearbid"
  description="Full-service Google Ads management, audits, campaign setup, and conversion tracking for small businesses in Delhi NCR. Transparent pricing, no lock-in."
>
  <div class="container-site">
    <Breadcrumbs crumbs={[
      { label: 'Home', href: '/' },
      { label: 'Services' }
    ]} />
  </div>

  <!-- Hero -->
  <section class="bg-gradient-to-br from-blue-950 to-blue-800 text-white py-16 lg:py-20">
    <div class="container-site text-center">
      <h1 class="text-4xl sm:text-5xl font-extrabold mb-6">Google Ads Services</h1>
      <p class="text-lg text-blue-100 max-w-2xl mx-auto mb-8">
        Everything you need to run profitable Google Ads — from your first campaign to scaling an already-performing account. Built for small and mid-sized businesses across Delhi NCR.
      </p>
      <a href="/contact/" class="btn-primary text-base px-8 py-4 inline-flex">
        Get My Free Google Ads Audit
      </a>
    </div>
  </section>

  <!-- Services grid -->
  <section class="py-16 lg:py-20">
    <div class="container-site">
      <div class="grid sm:grid-cols-2 gap-8 max-w-4xl mx-auto">
        {services.map(service => (
          <a
            href={service.href}
            class="relative bg-white rounded-xl border border-slate-200 hover:border-blue-300 hover:shadow-lg transition-all duration-200 p-8 group flex flex-col"
          >
            {service.badge && (
              <span class="absolute top-4 right-4 bg-orange-100 text-orange-700 text-xs font-semibold px-2 py-1 rounded-full">
                {service.badge}
              </span>
            )}
            <div class="text-4xl mb-4" aria-hidden="true">{service.icon}</div>
            <h2 class="text-xl font-bold text-blue-900 mb-3 group-hover:text-orange-500 transition-colors">
              {service.title}
            </h2>
            <p class="text-slate-600 text-sm flex-1">{service.desc}</p>
            <span class="mt-6 text-sm font-semibold text-orange-500 group-hover:translate-x-1 inline-block transition-transform">
              Learn more →
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Process strip -->
  <section class="py-16 lg:py-20 bg-slate-50">
    <div class="container-site">
      <h2 class="text-3xl font-bold text-blue-900 text-center mb-10">How we work</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6 max-w-5xl mx-auto">
        {processSteps.map(item => (
          <div class="bg-white rounded-xl p-6 text-center border border-slate-200">
            <div class="w-12 h-12 rounded-full bg-orange-50 border-2 border-orange-200 flex items-center justify-center mx-auto mb-4">
              <span class="text-lg font-extrabold text-orange-500">{item.step}</span>
            </div>
            <h3 class="font-bold text-blue-900 mb-2">{item.title}</h3>
            <p class="text-sm text-slate-600">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTASection />
</Layout>

<style>
  .btn-primary { display:inline-flex;align-items:center;justify-content:center;gap:0.5rem;padding:0.75rem 1.5rem;border-radius:0.5rem;background-color:#f97316;color:white;font-weight:600;transition:background-color 0.2s; }
  .btn-primary:hover { background-color:#ea580c; }
</style>
