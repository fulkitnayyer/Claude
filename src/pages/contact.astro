---
import Layout from '../layouts/Layout.astro';
import LeadForm from '../components/LeadForm.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import { SITE } from '../config/site';

const waText = encodeURIComponent("Hi, I'd like a free account audit for my business.");

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "ContactPage",
    "name": `Contact ${SITE.name}`,
    "url": `${SITE.url}/contact/`,
  },
  {
    "@context": "https://schema.org",
    "@type": "ProfessionalService",
    "name": SITE.legalName,
    "url": SITE.url,
    "telephone": SITE.phone,
    "email": SITE.email,
    "areaServed": SITE.areaServed.map(c => ({ "@type": "City", "name": c })),
  },
];
---

<Layout
  title={`Contact | ${SITE.name}`}
  description="Get your free Google Ads or Meta Ads account audit. Call, WhatsApp, or fill in the form — we reply within one business day."
  schema={schema}
  hideFooterCTA
>
  <div class="container"><Breadcrumbs crumbs={[{ label: 'Home', href: '/' }, { label: 'Contact' }]} /></div>

  <section class="section contact-section">
    <div class="container contact-grid">
      <div class="contact-info">
        <p class="eyebrow">Get your free account audit</p>
        <h1>Fill in the form, or reach us directly.</h1>
        <p class="lede">
          We'll review your account — or your competitors', if you're not running ads yet —
          and send back written findings. No pitch attached. We reply within one business day.
        </p>

        <ul class="contact-methods">
          <li>
            <a href={`tel:${SITE.phoneRaw}`}>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1-9.4 0-17-7.6-17-17 0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1L6.6 10.8z"/>
              </svg>
              <span><span class="contact-method-label muted">Call</span>{SITE.phone}</span>
            </a>
          </li>
          <li>
            <a href={`https://wa.me/${SITE.whatsapp}?text=${waText}`} target="_blank" rel="noopener noreferrer">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
              <span><span class="contact-method-label muted">WhatsApp</span>{SITE.phone}</span>
            </a>
          </li>
          <li>
            <a href={`mailto:${SITE.email}`}>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M1.5 8.67v8.58a3 3 0 003 3h15a3 3 0 003-3V8.67l-8.928 5.493a3 3 0 01-3.144 0L1.5 8.67z"/>
                <path d="M22.5 6.908V6.75a3 3 0 00-3-3h-15a3 3 0 00-3 3v.158l9.714 5.978a1.5 1.5 0 001.572 0L22.5 6.908z"/>
              </svg>
              <span><span class="contact-method-label muted">Email</span>{SITE.email}</span>
            </a>
          </li>
        </ul>
      </div>

      <div class="contact-form-wrap">
        <LeadForm heading="Tell us about your business" formId="lead-form-contact" />
      </div>
    </div>
  </section>
</Layout>

<style>
  .contact-grid {
    display: grid;
    gap: 2.5rem;
    align-items: start;
  }
  @media (min-width: 900px) {
    .contact-grid { grid-template-columns: 0.85fr 1fr; gap: 4rem; }
  }

  .contact-info h1 { margin-block: 0.6rem 1rem; max-width: 22ch; }
  .contact-info .lede { margin-bottom: 2rem; }

  .contact-methods { display: flex; flex-direction: column; }
  .contact-methods li { border-top: 1px solid var(--rule); }
  .contact-methods li:last-child { border-bottom: 1px solid var(--rule); }
  .contact-methods a {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-block: 1rem;
    font-family: var(--font-display);
    font-weight: 600;
  }
  .contact-methods a:hover { color: var(--accent); }
  .contact-method-label {
    display: block;
    font-family: var(--font-body);
    font-weight: 400;
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .contact-form-wrap {
    border: 1px solid var(--rule);
    padding: 1.75rem;
    border-radius: var(--radius);
  }
</style>
