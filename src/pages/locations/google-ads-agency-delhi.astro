---
import Layout from '../../layouts/Layout.astro';
import CTASection from '../../components/ui/CTASection.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
---

<Layout
  title="Google Ads Agency in Delhi | Clearbid"
  description="Google Ads management for businesses in Delhi. Search, Display, and Performance Max campaigns for SMBs across Central, South, West, and North Delhi."
>
  <div class="container-site">
    <Breadcrumbs crumbs={[
      { label: 'Home', href: '/' },
      { label: 'Locations', href: '/locations/' },
      { label: 'Google Ads Agency in Delhi' }
    ]} />
  </div>

  <section class="bg-gradient-to-br from-blue-950 to-blue-800 text-white py-16 lg:py-20">
    <div class="container-site max-w-3xl">
      <h1 class="text-4xl sm:text-5xl font-extrabold mb-6">Google Ads Agency in Delhi</h1>
      <p class="text-lg text-blue-100 mb-8">
        Clearbid manages Google Ads campaigns for businesses across Delhi — from South Delhi's professional services corridor to the retail hubs of Karol Bagh, Lajpat Nagar, and Dwarka. Localised targeting, transparent reporting, no lock-in.
      </p>
      <a href="/contact/" class="btn-primary inline-flex text-base px-8 py-4">
        Get a Free Delhi Audit
      </a>
    </div>
  </section>

  <section class="py-16 lg:py-20">
    <div class="container-site max-w-4xl">
      <h2 class="text-3xl font-bold text-blue-900 mb-6">Google Ads for Delhi businesses</h2>
      <p class="text-slate-600 text-lg mb-6">
        Delhi is a high-density, high-competition market with deeply local search behaviour. A buyer searching "dentist in Vasant Vihar" has very different intent to one searching "best dentist in Delhi" — and your campaigns need to reflect that nuance.
      </p>
      <p class="text-slate-600 text-lg mb-10">
        We build campaigns that target Delhi by locality, pincode, radius, and intent — so your budget reaches the right people, not the whole city.
      </p>

      <div class="mb-8">
        <h3 class="font-bold text-blue-900 mb-4">Areas served in Delhi</h3>
        <div class="flex flex-wrap gap-2">
          {['South Delhi', 'Central Delhi', 'West Delhi', 'North Delhi', 'East Delhi', 'Dwarka', 'Rohini', 'Karol Bagh', 'Lajpat Nagar', 'Saket', 'Vasant Vihar', 'Greater Kailash', 'Janakpuri', 'Pitampura'].map(a => (
            <span class="bg-slate-100 text-slate-700 text-sm px-3 py-1 rounded-full">{a}</span>
          ))}
        </div>
      </div>

      <!-- Case study placeholder -->
      <div class="bg-slate-50 rounded-xl p-6 border border-slate-200 mb-8">
        <p class="text-sm font-semibold text-orange-500 uppercase tracking-wider mb-2">Case study — Delhi</p>
        <p class="text-slate-500 italic text-sm">
          [PLACEHOLDER: Add a real Delhi case study here.]
        </p>
      </div>

      <div class="flex flex-wrap gap-3 text-sm">
        <a href="/services/google-ads-management/" class="text-blue-700 underline hover:text-orange-500">Google Ads Management</a>
        <span class="text-slate-300">·</span>
        <a href="/locations/google-ads-agency-gurgaon/" class="text-blue-700 underline hover:text-orange-500">Gurgaon</a>
        <span class="text-slate-300">·</span>
        <a href="/locations/google-ads-agency-noida/" class="text-blue-700 underline hover:text-orange-500">Noida</a>
        <span class="text-slate-300">·</span>
        <a href="/pricing/" class="text-blue-700 underline hover:text-orange-500">Pricing</a>
      </div>
    </div>
  </section>

  <CTASection heading="Grow your Delhi business with Google Ads" primaryLabel="Get My Free Delhi Audit" />
</Layout>

<style>
  .btn-primary { display:inline-flex;align-items:center;justify-content:center;gap:0.5rem;padding:0.75rem 1.5rem;border-radius:0.5rem;background-color:#f97316;color:white;font-weight:600;transition:background-color 0.2s; }
  .btn-primary:hover { background-color:#ea580c; }
</style>
