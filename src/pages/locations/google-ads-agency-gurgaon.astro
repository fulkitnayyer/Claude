---
import Layout from '../../layouts/Layout.astro';
import CTASection from '../../components/ui/CTASection.astro';
import FAQAccordion from '../../components/ui/FAQAccordion.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import LeadForm from '../../components/LeadForm.astro';
import { SITE } from '../../config/site';

const schema = [
  {
    "@context": "https://schema.org",
    "@type": ["LocalBusiness", "ProfessionalService"],
    "name": `${SITE.name} — Google Ads Agency in Gurgaon`,
    "url": "https://clearbid.in/locations/google-ads-agency-gurgaon/",
    "telephone": SITE.phone,
    "email": SITE.email,
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Gurgaon",
      "addressRegion": "Haryana",
      "addressCountry": "IN"
    },
    "areaServed": [
      { "@type": "City", "name": "Gurgaon" },
      { "@type": "City", "name": "Gurugram" },
    ],
    "serviceType": "Google Ads Management",
    "description": "Google Ads management for businesses in Gurgaon (Gurugram). Specialising in real estate, healthcare, education, and local service businesses."
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Is there a Google Ads agency near me in Gurgaon?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Clearbid serves businesses across Gurgaon / Gurugram including DLF, Cyber City, Golf Course Road, Sohna Road, NH-48, Manesar, and surrounding areas. We work remotely and can meet clients in Gurgaon."
        }
      }
    ]
  }
];

const gurgaonAreas = [
  'DLF Cyber City', 'Golf Course Road', 'Sohna Road', 'MG Road', 'NH-48 Corridor',
  'Udyog Vihar', 'Manesar', 'Sector 29', 'Sector 56', 'Palam Vihar', 'New Gurugram',
];

const faqs = [
  {
    question: "Do you work with businesses in Gurgaon specifically?",
    answer: "Yes. We serve businesses across Gurgaon / Gurugram — from DLF Cyber City and Golf Course Road to Sohna Road, Manesar, and New Gurugram. Our campaigns are set up to target Gurgaon local searches specifically."
  },
  {
    question: "Which industries do you work with in Gurgaon?",
    answer: "Real estate developers, healthcare clinics, diagnostic centres, coaching institutes, co-working spaces, restaurants, retail, and professional service firms. Real estate and healthcare are our most common verticals in Gurgaon."
  },
  {
    question: "Can I meet you in person in Gurgaon?",
    answer: "We primarily work remotely (calls, WhatsApp, video meetings), but we can arrange a meeting in Gurgaon. Drop us a message to schedule."
  },
  {
    question: "What's a realistic budget for Google Ads in Gurgaon?",
    answer: "For competitive local markets like real estate or healthcare in Gurgaon, we recommend a minimum of ₹50,000/month in ad spend. For simpler local services (e.g. a single-location restaurant), ₹25,000/month can work. We'll tell you what's realistic for your specific category."
  },
];
---

<Layout
  title="Google Ads Agency in Gurgaon | Clearbid"
  description="Google Ads management for businesses in Gurgaon (Gurugram). More leads from local searches in DLF, Golf Course Road, Sohna Road & across Gurugram. Free audit."
  schema={schema}
>
  <div class="container-site">
    <Breadcrumbs crumbs={[
      { label: 'Home', href: '/' },
      { label: 'Locations', href: '/locations/' },
      { label: 'Google Ads Agency in Gurgaon' }
    ]} />
  </div>

  <!-- Hero -->
  <section class="bg-gradient-to-br from-blue-950 to-blue-800 text-white py-16 lg:py-20">
    <div class="container-site">
      <div class="grid lg:grid-cols-2 gap-12 items-start">
        <div>
          <span class="text-sm font-semibold text-orange-400 uppercase tracking-wider mb-4 block">
            Google Ads · Gurgaon / Gurugram
          </span>
          <h1 class="text-4xl sm:text-5xl font-extrabold mb-6">
            Google Ads Agency in Gurgaon
          </h1>
          <p class="text-lg text-blue-100 mb-8">
            Helping businesses across Gurgaon win more customers from Google — real estate developers, healthcare clinics, coaching institutes, and local service businesses. Dedicated Google Ads management, transparent reporting, no lock-in contracts.
          </p>
          <div class="flex flex-wrap gap-4">
            <a href="/contact/" class="btn-primary inline-flex text-base px-8 py-4">
              Get a Free Gurgaon Audit
            </a>
          </div>
        </div>
        <div>
          <LeadForm variant="hero" heading="Free audit for Gurgaon businesses" />
        </div>
      </div>
    </div>
  </section>

  <!-- Why Google Ads in Gurgaon -->
  <section class="py-16 lg:py-20">
    <div class="container-site max-w-4xl">
      <h2 class="text-3xl font-bold text-blue-900 mb-6">
        Google Ads in Gurgaon — what makes it different
      </h2>
      <p class="text-slate-600 text-lg mb-6">
        Gurgaon is one of the most competitive digital ad markets in India. Real estate developers, hospitals, coaching centres, and professional services firms all compete aggressively for the same high-intent searches — "2BHK apartments in Gurgaon", "best cardiologist in Gurugram", "IIT coaching Gurgaon".
      </p>
      <p class="text-slate-600 text-lg mb-8">
        That competition means CPCs are high — but it also means buyers are serious. A well-structured Google Ads campaign targeting specific Gurgaon localities and intent signals consistently outperforms broad, poorly-structured campaigns, even at lower budgets.
      </p>

      <div class="grid sm:grid-cols-3 gap-6">
        {[
          { icon: '🏙️', title: 'High-intent local searches', desc: 'Gurgaon buyers search with strong purchase intent. Targeting by locality, pincode, and intent cluster drives better leads.' },
          { icon: '🏢', title: 'Sector-level targeting', desc: 'We target Gurgaon by sector, colony, and road — so your ads reach buyers in your catchment area, not across Delhi NCR.' },
          { icon: '📱', title: 'Mobile-first campaigns', desc: 'Over 70% of Gurgaon local searches happen on mobile. Our campaigns are built for mobile-first bidding and landing pages.' },
        ].map(item => (
          <div class="bg-slate-50 rounded-xl p-6">
            <div class="text-3xl mb-3" aria-hidden="true">{item.icon}</div>
            <h3 class="font-bold text-blue-900 mb-2">{item.title}</h3>
            <p class="text-sm text-slate-600">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Areas served -->
  <section class="py-12 bg-slate-50">
    <div class="container-site max-w-4xl">
      <h2 class="text-2xl font-bold text-blue-900 mb-6">Areas we serve in Gurgaon</h2>
      <div class="flex flex-wrap gap-3">
        {gurgaonAreas.map(area => (
          <span class="bg-white border border-slate-200 text-slate-700 text-sm px-4 py-2 rounded-full">
            {area}
          </span>
        ))}
      </div>
      <p class="mt-4 text-sm text-slate-500">
        Don't see your area? We serve all of Gurgaon / Gurugram — <a href="/contact/" class="text-blue-700 underline">get in touch</a>.
      </p>
    </div>
  </section>

  <!-- Industries in Gurgaon -->
  <section class="py-16 lg:py-20">
    <div class="container-site max-w-4xl">
      <h2 class="text-3xl font-bold text-blue-900 mb-8">Industries we serve in Gurgaon</h2>
      <div class="grid sm:grid-cols-2 gap-6">
        {[
          {
            title: 'Real estate',
            desc: 'Residential developers, commercial leasing, plotted development. We know the Gurgaon real-estate ad landscape — Golf Course Extension, Dwarka Expressway, New Gurugram. See our real estate page.',
            href: '/industries/real-estate/',
          },
          {
            title: 'Healthcare & clinics',
            desc: 'Hospitals, multi-specialty clinics, diagnostic centres, dental practices. High-intent local searches with good conversion rates when campaigns are structured correctly.',
            href: '/industries/healthcare/',
          },
          {
            title: 'Education & coaching',
            desc: 'IIT/JEE/NEET coaching, MBA prep, school admissions, skill courses. Gurgaon has a dense, educated population actively searching for quality education options.',
            href: '/industries/education/',
          },
          {
            title: 'Professional services',
            desc: 'Law firms, CAs, architects, consultants, co-working spaces. Longer sales cycles but high lifetime value — Google Ads works well for discovery and retargeting.',
            href: '/services/',
          },
        ].map(item => (
          <div class="bg-white rounded-xl border border-slate-200 p-6">
            <h3 class="font-bold text-blue-900 mb-2">{item.title}</h3>
            <p class="text-sm text-slate-600 mb-3">{item.desc}</p>
            <a href={item.href} class="text-sm font-semibold text-orange-500 hover:text-orange-600 transition-colors">
              Learn more →
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Case study teaser -->
  <section class="py-10 bg-slate-50">
    <div class="container-site max-w-4xl">
      <div class="bg-white rounded-xl border border-slate-200 p-8">
        <p class="text-sm font-semibold text-orange-500 uppercase tracking-wider mb-2">Case study — Gurgaon</p>
        <p class="text-slate-500 italic">
          [PLACEHOLDER: Add a real Gurgaon case study once available. Example: "How a Gurgaon real-estate developer generated 85 qualified leads in 60 days at ₹X per lead using targeted Search campaigns."]
        </p>
        <a href="/results/" class="mt-4 inline-flex text-sm font-semibold text-blue-700 hover:text-orange-500">
          See all case studies →
        </a>
      </div>
    </div>
  </section>

  <!-- Internal links -->
  <section class="py-8">
    <div class="container-site max-w-4xl">
      <p class="text-sm text-slate-500 mb-3">Related pages:</p>
      <div class="flex flex-wrap gap-3">
        <a href="/services/google-ads-management/" class="text-sm text-blue-700 underline hover:text-orange-500">Google Ads Management</a>
        <span class="text-slate-300">·</span>
        <a href="/services/google-ads-audit/" class="text-sm text-blue-700 underline hover:text-orange-500">Free Audit</a>
        <span class="text-slate-300">·</span>
        <a href="/industries/real-estate/" class="text-sm text-blue-700 underline hover:text-orange-500">Real Estate</a>
        <span class="text-slate-300">·</span>
        <a href="/pricing/" class="text-sm text-blue-700 underline hover:text-orange-500">Pricing</a>
        <span class="text-slate-300">·</span>
        <a href="/locations/google-ads-agency-delhi/" class="text-sm text-blue-700 underline hover:text-orange-500">Delhi</a>
        <span class="text-slate-300">·</span>
        <a href="/locations/google-ads-agency-noida/" class="text-sm text-blue-700 underline hover:text-orange-500">Noida</a>
      </div>
    </div>
  </section>

  <FAQAccordion {faqs} heading="Google Ads in Gurgaon — FAQs" />

  <CTASection
    heading="Ready to grow your Gurgaon business with Google Ads?"
    subtext="Start with a free audit. We'll review your account or market and give you a clear action plan — no obligation."
    primaryLabel="Get My Free Gurgaon Audit"
  />
</Layout>

<style>
  .btn-primary { display:inline-flex;align-items:center;justify-content:center;gap:0.5rem;padding:0.75rem 1.5rem;border-radius:0.5rem;background-color:#f97316;color:white;font-weight:600;transition:background-color 0.2s; }
  .btn-primary:hover { background-color:#ea580c; }
</style>
