---
import Layout from '../../layouts/Layout.astro';
import CTASection from '../../components/ui/CTASection.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
---

<Layout
  title="Google Ads Agency in Noida | Clearbid"
  description="Google Ads management for businesses in Noida and Greater Noida. Targeted campaigns for sectors 18, 62, 63, Tech Park corridor, and Greater Noida West."
>
  <div class="container-site">
    <Breadcrumbs crumbs={[
      { label: 'Home', href: '/' },
      { label: 'Locations', href: '/locations/' },
      { label: 'Google Ads Agency in Noida' }
    ]} />
  </div>

  <section class="bg-gradient-to-br from-blue-950 to-blue-800 text-white py-16 lg:py-20">
    <div class="container-site max-w-3xl">
      <h1 class="text-4xl sm:text-5xl font-extrabold mb-6">Google Ads Agency in Noida</h1>
      <p class="text-lg text-blue-100 mb-8">
        Google Ads management for businesses in Noida, Greater Noida, and Noida Extension. IT parks, real estate, healthcare, education — Clearbid builds localised campaigns that convert Noida's high-intent searchers into leads.
      </p>
      <a href="/contact/" class="btn-primary inline-flex text-base px-8 py-4">
        Get a Free Noida Audit
      </a>
    </div>
  </section>

  <section class="py-16 lg:py-20">
    <div class="container-site max-w-4xl">
      <h2 class="text-3xl font-bold text-blue-900 mb-6">Google Ads for Noida businesses</h2>
      <p class="text-slate-600 text-lg mb-6">
        Noida has evolved into a full-service metro — with a tech-savvy, higher-income population that researches heavily online before buying. Real estate in sectors 150, 137, and Greater Noida West is among the most-searched in NCR. Healthcare and coaching markets are equally competitive.
      </p>

      <div class="mb-8">
        <h3 class="font-bold text-blue-900 mb-4">Areas served in Noida</h3>
        <div class="flex flex-wrap gap-2">
          {['Sector 18', 'Sector 62', 'Sector 63', 'Sector 137', 'Sector 150', 'Greater Noida', 'Greater Noida West', 'Noida Extension', 'Expressway Corridor', 'Knowledge Park'].map(a => (
            <span class="bg-slate-100 text-slate-700 text-sm px-3 py-1 rounded-full">{a}</span>
          ))}
        </div>
      </div>

      <div class="bg-slate-50 rounded-xl p-6 border border-slate-200 mb-8">
        <p class="text-sm font-semibold text-orange-500 uppercase tracking-wider mb-2">Case study — Noida</p>
        <p class="text-slate-500 italic text-sm">
          [PLACEHOLDER: Add a real Noida case study here.]
        </p>
      </div>

      <div class="flex flex-wrap gap-3 text-sm">
        <a href="/services/google-ads-management/" class="text-blue-700 underline hover:text-orange-500">Google Ads Management</a>
        <span class="text-slate-300">·</span>
        <a href="/locations/google-ads-agency-gurgaon/" class="text-blue-700 underline hover:text-orange-500">Gurgaon</a>
        <span class="text-slate-300">·</span>
        <a href="/locations/google-ads-agency-delhi/" class="text-blue-700 underline hover:text-orange-500">Delhi</a>
        <span class="text-slate-300">·</span>
        <a href="/pricing/" class="text-blue-700 underline hover:text-orange-500">Pricing</a>
      </div>
    </div>
  </section>

  <CTASection heading="Grow your Noida business with Google Ads" primaryLabel="Get My Free Noida Audit" />
</Layout>

<style>
  .btn-primary { display:inline-flex;align-items:center;justify-content:center;gap:0.5rem;padding:0.75rem 1.5rem;border-radius:0.5rem;background-color:#f97316;color:white;font-weight:600;transition:background-color 0.2s; }
  .btn-primary:hover { background-color:#ea580c; }
</style>
