---
import Layout from '../layouts/Layout.astro';
import LeadForm from '../components/LeadForm.astro';
import AccountStructureDiagram from '../components/AccountStructureDiagram.astro';
import FAQAccordion from '../components/ui/FAQAccordion.astro';
import { SITE } from '../config/site';

const faqs = [
  {
    question: 'What does the free audit actually include?',
    answer: "We go through your existing Google Ads or Meta Ads account — campaign structure, search terms, negative keywords, conversion tracking, and landing pages — and send back written findings with what we'd change first. If you're not running ads yet, we do the same review against two or three competitors in your city instead. Either way, you keep the document whether you hire us or not.",
  },
  {
    question: "Why is 'account structure' the first thing you look at?",
    answer: "Because it decides everything downstream. If one campaign is carrying five different jobs — emergency callouts, routine bookings, annual contracts — the algorithm can't tell which clicks matter more, so it spends evenly across all of them. Fixing structure first means every other change (bids, ad copy, budgets) actually has something solid to work on.",
  },
  {
    question: "I've been burned by an agency before. What's different here?",
    answer: "You keep admin access to your own Ad Manager and Business Manager accounts from day one — we're added as a user, not the owner. Every month you get the same report we'd show ourselves internally, not a slide deck. And nothing before this agency existed can be shown as a case study, so we don't pretend otherwise — you're judging this on the audit and the way we work, not on screenshots.",
  },
  {
    question: 'How much does this cost?',
    answer: 'Management starts from ₹25,000/month plus your ad spend, and moves up from there depending on how many campaigns, locations, and platforms you need. See the <a href="/services/" class="accent-underline">Services page</a> for the full breakdown. No setup fee, no annual contract.',
  },
  {
    question: 'Do you work with businesses outside Delhi NCR?',
    answer: "Yes. Most of the work happens over WhatsApp, email, and screen-share calls, so location doesn't change how we work. We currently work with businesses in Delhi NCR, Mumbai, Bengaluru, Pune, Hyderabad, and a handful of tier-2 cities.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.question,
    "acceptedAnswer": { "@type": "Answer", "text": f.answer.replace(/<[^>]+>/g, '') },
  })),
};
---

<Layout
  title={`${SITE.name} — Google Ads & Meta Ads for local businesses and agencies`}
  description={SITE.description}
  schema={faqSchema}
>
  <!-- HERO -->
  <section class="section hero">
    <div class="container">
      <div class="hero-top">
        <p class="eyebrow hero-in hero-in-1">Google Ads · Meta Ads · Ex-Google Account Strategist</p>
        <h1 class="hero-in hero-in-2">
          Your Google Ads account probably has one campaign doing five jobs.
        </h1>
        <p class="lede hero-in hero-in-3">
          Emergency callouts, routine bookings, and annual contracts — all bidding against
          each other in the same campaign, at the same price, all day. That's why the
          cost-per-lead looks fine on the dashboard and the phone still doesn't ring.
          Here's what that costs, and how we'd split it.
        </p>
        <div class="hero-actions hero-in hero-in-4">
          <a href="/industries/" class="btn btn-primary">I run a local business</a>
          <a href="/white-label/" class="btn btn-secondary">I run a marketing agency</a>
        </div>
      </div>
    </div>

    <div class="container hero-diagram-wrap">
      <p class="hero-diagram-caption muted">
        A real Google Ads account structure for a plumbing business — not a mockup.
      </p>
      <AccountStructureDiagram />
    </div>
  </section>

  <!-- TRUST ROW -->
  <div class="rule"></div>
  <section class="trust-row">
    <div class="container">
      <ul>
        <li>Google Ads Certified</li>
        <li>Meta Blueprint Certified</li>
        <li>3 years as a Google Ads Account Strategist, at Google</li>
      </ul>
    </div>
  </section>
  <div class="rule"></div>

  <!-- WHAT'S BROKEN -->
  <section class="section problems">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">What's broken in most accounts</p>
        <h2>Three specific things we find, almost every time</h2>
      </div>

      <div class="problem-list">
        <article class="problem-row">
          <p class="problem-figure stat-figure">₹380<span class="problem-figure-unit">/click</span></p>
          <div class="problem-body">
            <h3>For a click that was never going to convert</h3>
            <p>
              Broad match on a head term like "plumber near me" pulls in browsers, trade-school
              students, and staff from the plumbing supply shop down the road. Nobody's reading
              the search terms report until the budget's already spent.
            </p>
          </div>
        </article>

        <article class="problem-row">
          <p class="problem-figure stat-figure">1<span class="problem-figure-unit"> number, 3 kinds of calls</span></p>
          <div class="problem-body">
            <h3>And no way to tell which ad paid for which one</h3>
            <p>
              Without call tracking, a ₹4,000 emergency job and a tyre-kicker asking for a free
              quote look identical in the spreadsheet. You can't cut what's working from what
              isn't if every lead reads the same.
            </p>
          </div>
        </article>

        <article class="problem-row">
          <p class="problem-figure stat-figure">1<span class="problem-figure-unit"> landing page, 2 jobs</span></p>
          <div class="problem-body">
            <h3>Built for search rankings, used for paid clicks</h3>
            <p>
              Organic traffic and ₹1,200-a-click paid traffic want different things from a page.
              Sending both to the same generic "our services" page is usually the real reason
              the phone doesn't ring — not the bid, not the budget.
            </p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- TWO PATHS -->
  <section class="section paths tint">
    <div class="container paths-grid">
      <div class="path-card">
        <p class="eyebrow">For local businesses</p>
        <h2>Plumbers, clinics, gyms, real estate agents — service businesses that live or die by the phone ringing.</h2>
        <p class="lede">
          We manage the account end to end: structure, bidding, landing pages, call tracking,
          and a monthly report you can actually read.
        </p>
        <a href="/industries/" class="btn btn-secondary">See how we handle your industry</a>
      </div>
      <div class="path-card">
        <p class="eyebrow">For marketing agencies</p>
        <h2>Outsource Google and Meta Ads execution, delivered under your own brand.</h2>
        <p class="lede">
          You keep the client relationship. We run the accounts, write the reports on your
          letterhead, and stay invisible unless you tell us otherwise.
        </p>
        <a href="/white-label/" class="btn btn-secondary">See white-label terms</a>
      </div>
    </div>
  </section>

  <!-- WHY TRUST US -->
  <section class="section trust-block">
    <div class="container trust-block-grid">
      <div>
        <p class="eyebrow">Why trust us with your ad spend</p>
        <h2>There's no client logo wall on this site. Here's why, and what we show you instead.</h2>
        <p class="lede">
          Every account managed before this agency existed was managed while working at
          Google, under NDA. We can't show it to you — so we don't pretend otherwise, and we
          don't inflate the gap with stock testimonials. What we can show you: exactly how we
          think about your account, for free, before you pay us anything.
        </p>
      </div>
      <div class="trust-block-list">
        <div class="trust-block-item">
          <h3>The free audit</h3>
          <p>Written findings on your account or your competitors' — not a sales call disguised as one.</p>
        </div>
        <div class="trust-block-item">
          <h3>You own the account</h3>
          <p>We're added as a user on your Ad Manager and Business Manager. You hold the keys, always.</p>
        </div>
        <div class="trust-block-item">
          <h3>No lock-in</h3>
          <p>Month-to-month. If the reporting or the results stop making sense, you leave with everything intact.</p>
        </div>
      </div>
    </div>
    <!-- TESTIMONIAL SLOT — add after first 3 clients -->
  </section>

  <!-- LEAD FORM -->
  <section class="section lead-section tint">
    <div class="container lead-section-grid">
      <div>
        <p class="eyebrow">Free account audit</p>
        <h2>Send this over. We'll tell you what's wrong before you spend another rupee.</h2>
        <p class="lede">
          Takes about ten minutes to fill in. You'll hear back within one business day, by
          WhatsApp or email — whichever you'd rather use.
        </p>
      </div>
      <div class="lead-section-form">
        <LeadForm heading="Get your free account audit" formId="lead-form-home" />
      </div>
    </div>
  </section>

  <FAQAccordion faqs={faqs} heading="Questions people ask before signing up" />
</Layout>

<style>
  .hero { padding-block: 3rem 0; }
  .hero-top { max-width: 46rem; }
  .hero h1 {
    font-size: var(--fs-hero);
    margin-block: 1rem 1.25rem;
    max-width: 18ch;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 1.75rem;
  }

  .hero-diagram-wrap {
    margin-top: 3rem;
  }
  .hero-diagram-caption {
    font-size: var(--fs-xs);
    margin-bottom: 0.5rem;
  }

  .trust-row { padding-block: 1.1rem; }
  .trust-row ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.5rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--fs-sm);
  }
  .trust-row li { list-style: none; }
  .trust-row li:not(:last-child)::after {
    content: '';
  }

  .section-head { max-width: 40rem; margin-bottom: 2.5rem; }
  .section-head h2 { margin-top: 0.6rem; }

  .problem-list { display: flex; flex-direction: column; }
  .problem-row {
    display: grid;
    gap: 0.5rem 2.5rem;
    padding-block: 1.75rem;
    border-top: 1px solid var(--rule);
  }
  .problem-row:last-child { border-bottom: 1px solid var(--rule); }

  @media (min-width: 800px) {
    .problem-row { grid-template-columns: 12rem 1fr; align-items: baseline; }
  }

  .problem-figure {
    font-size: 1.75rem;
    white-space: nowrap;
  }
  .problem-figure-unit {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: var(--fs-sm);
    color: var(--muted);
  }

  .problem-body h3 { font-size: var(--fs-h3); margin-bottom: 0.4rem; }
  .problem-body p { color: var(--muted); max-width: 56ch; }

  .paths-grid {
    display: grid;
    gap: 2.5rem;
  }
  @media (min-width: 800px) {
    .paths-grid { grid-template-columns: 1fr 1fr; gap: 4rem; }
  }
  .path-card h2 { margin-block: 0.6rem 0.85rem; font-size: var(--fs-h2); }
  .path-card .lede { margin-bottom: 1.5rem; }

  .trust-block-grid {
    display: grid;
    gap: 2.5rem;
  }
  @media (min-width: 900px) {
    .trust-block-grid { grid-template-columns: 1fr 0.85fr; gap: 4rem; }
  }
  .trust-block-grid > div:first-child h2 { margin-block: 0.6rem 1rem; }

  .trust-block-list { display: flex; flex-direction: column; }
  .trust-block-item {
    padding-block: 1.25rem;
    border-top: 1px solid var(--rule);
  }
  .trust-block-item:last-child { border-bottom: 1px solid var(--rule); }
  .trust-block-item h3 { font-size: var(--fs-body); margin-bottom: 0.3rem; }
  .trust-block-item p { color: var(--muted); font-size: var(--fs-sm); }

  .lead-section-grid {
    display: grid;
    gap: 2.5rem;
    align-items: start;
  }
  @media (min-width: 900px) {
    .lead-section-grid { grid-template-columns: 0.85fr 1fr; gap: 4rem; }
  }
  .lead-section-grid h2 { margin-block: 0.6rem 1rem; }
</style>
