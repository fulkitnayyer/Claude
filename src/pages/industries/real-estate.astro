---
import Layout from '../../layouts/Layout.astro';
import CTASection from '../../components/ui/CTASection.astro';
import FAQAccordion from '../../components/ui/FAQAccordion.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Google Ads for Real Estate",
  "provider": { "@type": "LocalBusiness", "name": "Clearbid", "url": "https://clearbid.in" },
  "serviceType": "Google Ads Management — Real Estate",
  "areaServed": "Delhi NCR",
};

const faqs = [
  {
    question: "What keywords work best for real estate Google Ads in Delhi NCR?",
    answer: "High-intent transactional keywords: '[project type] in [locality]', '2BHK apartments Gurgaon', 'plots in Noida Extension'. We layer in location targeting and audience signals (in-market for real estate) to reach buyers at the right moment."
  },
  {
    question: "What's a realistic cost per lead for real estate Google Ads?",
    answer: "CPL varies hugely by locality, project type, and budget. In competitive Gurgaon markets (luxury residential), expect ₹800–₹2,000+ per lead. In tier-2 locations within NCR, CPLs can be lower. We'll give you a benchmark estimate for your specific project before you spend anything."
  },
  {
    question: "Should I use Search or Display ads for real estate?",
    answer: "Start with Search — it captures buyers who are actively searching for properties. Add Display and YouTube retargeting once you have enough traffic to build meaningful audiences. Performance Max is worth testing once Search campaigns are profitable."
  },
];
---

<Layout
  title="Google Ads for Real Estate in Delhi NCR | Clearbid"
  description="Google Ads management for real estate developers in Delhi, Gurgaon, and Noida. Generate qualified buyer leads for residential, commercial, and plotted projects."
  schema={schema}
>
  <div class="container-site">
    <Breadcrumbs crumbs={[
      { label: 'Home', href: '/' },
      { label: 'Industries', href: '/industries/' },
      { label: 'Real Estate' }
    ]} />
  </div>

  <section class="bg-gradient-to-br from-blue-950 to-blue-800 text-white py-16 lg:py-20">
    <div class="container-site max-w-3xl">
      <h1 class="text-4xl sm:text-5xl font-extrabold mb-6">Google Ads for Real Estate</h1>
      <p class="text-lg text-blue-100 mb-8">
        Google Ads for real estate in Delhi NCR is one of the most competitive — and most rewarding — digital channels when done right. We specialise in generating qualified buyer enquiries for residential developers, commercial projects, and plotted schemes.
      </p>
      <a href="/contact/" class="btn-primary inline-flex text-base px-8 py-4">Get a Free Real Estate Audit</a>
    </div>
  </section>

  <section class="py-16 lg:py-20">
    <div class="container-site max-w-4xl">
      <h2 class="text-3xl font-bold text-blue-900 mb-6">Common pain points — and how we fix them</h2>
      <div class="grid sm:grid-cols-2 gap-6">
        {[
          { problem: 'High CPCs eating into budget', fix: 'Tight keyword grouping, quality score optimisation, and locality-specific campaigns reduce wasted spend.' },
          { problem: 'Unqualified leads wasting sales team time', fix: 'Budget qualifier in forms, income targeting, and intent-based keyword selection improve lead quality.' },
          { problem: 'No visibility into which ads generate site visits', fix: 'Conversion tracking from click to lead form to CRM — so you know your true cost per qualified lead.' },
          { problem: 'Broad geographic targeting wasting budget on irrelevant geographies', fix: 'Pincode, radius, and locality-level targeting focused on your catchment area.' },
        ].map(item => (
          <div class="bg-slate-50 rounded-xl p-6">
            <p class="text-red-600 font-semibold text-sm mb-2">❌ {item.problem}</p>
            <p class="text-green-700 text-sm">✓ {item.fix}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-10 bg-slate-50">
    <div class="container-site max-w-4xl">
      <div class="bg-white rounded-xl border border-slate-200 p-8 mb-6">
        <p class="text-sm font-semibold text-orange-500 uppercase tracking-wider mb-2">Case study</p>
        <p class="text-slate-500 italic text-sm">
          [PLACEHOLDER: Real estate case study — e.g. "A Gurgaon residential developer generated 120 qualified leads at ₹X per lead in 90 days using targeted Search campaigns for 3BHK apartments on Golf Course Extension Road."]
        </p>
      </div>
      <div class="flex flex-wrap gap-3 text-sm">
        <a href="/locations/google-ads-agency-gurgaon/" class="text-blue-700 underline hover:text-orange-500">Gurgaon</a>
        <span class="text-slate-300">·</span>
        <a href="/locations/google-ads-agency-delhi/" class="text-blue-700 underline hover:text-orange-500">Delhi</a>
        <span class="text-slate-300">·</span>
        <a href="/locations/google-ads-agency-noida/" class="text-blue-700 underline hover:text-orange-500">Noida</a>
        <span class="text-slate-300">·</span>
        <a href="/services/google-ads-management/" class="text-blue-700 underline hover:text-orange-500">Management</a>
        <span class="text-slate-300">·</span>
        <a href="/pricing/" class="text-blue-700 underline hover:text-orange-500">Pricing</a>
      </div>
    </div>
  </section>

  <FAQAccordion {faqs} heading="Real estate Google Ads — FAQs" />
  <CTASection heading="Generate more qualified real estate leads" subtext="Free audit — we'll review your campaigns or competitor landscape and share a specific action plan for your project." primaryLabel="Get My Free Real Estate Audit" />
</Layout>

<style>
  .btn-primary { display:inline-flex;align-items:center;justify-content:center;gap:0.5rem;padding:0.75rem 1.5rem;border-radius:0.5rem;background-color:#f97316;color:white;font-weight:600;transition:background-color 0.2s; }
  .btn-primary:hover { background-color:#ea580c; }
</style>
