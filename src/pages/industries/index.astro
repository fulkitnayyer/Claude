---
import Layout from '../../layouts/Layout.astro';
import CTASection from '../../components/ui/CTASection.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';

const industries = [
  { name: 'Real Estate', href: '/industries/real-estate/', live: true, desc: 'Residential developers, plotted projects, commercial leasing across Delhi NCR.' },
  { name: 'Healthcare', href: '/industries/healthcare/', live: true, desc: 'Hospitals, clinics, diagnostic centres, dental practices, and wellness brands.' },
  { name: 'Education', href: '/industries/education/', live: true, desc: 'Coaching institutes, schools, universities, and ed-tech platforms.' },
  { name: 'E-commerce', href: '/industries/ecommerce/', live: false, desc: 'Shopping, Performance Max, and product listing optimisation.' },
  { name: 'Finance & Insurance', href: '/industries/finance/', live: false, desc: 'Mutual funds, insurance, loans, and wealth management firms.' },
  { name: 'Hospitality & Travel', href: '/industries/hospitality/', live: false, desc: 'Hotels, tour operators, event venues, and travel agencies.' },
];
---

<Layout
  title="Google Ads for Industries | Clearbid"
  description="Industry-specific Google Ads management for real estate, healthcare, education, e-commerce, and more. Delhi NCR specialists."
>
  <div class="container-site">
    <Breadcrumbs crumbs={[{ label: 'Home', href: '/' }, { label: 'Industries' }]} />
  </div>

  <section class="bg-gradient-to-br from-blue-950 to-blue-800 text-white py-16 text-center">
    <div class="container-site max-w-3xl">
      <h1 class="text-4xl sm:text-5xl font-extrabold mb-4">Google Ads by Industry</h1>
      <p class="text-blue-100 text-lg">
        Every industry has different buyer intent, CPCs, and conversion patterns. We build campaigns that reflect your specific market.
      </p>
    </div>
  </section>

  <section class="py-16 lg:py-20">
    <div class="container-site">
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 max-w-5xl mx-auto">
        {industries.map(ind => (
          <div class={`rounded-xl border p-6 ${ind.live ? 'border-blue-200 bg-white hover:shadow-md transition-shadow' : 'border-slate-100 bg-slate-50'}`}>
            <div class="flex items-center justify-between mb-3">
              <h2 class="text-lg font-bold text-blue-900">{ind.name}</h2>
              {ind.live
                ? <span class="bg-green-100 text-green-700 text-xs font-semibold px-2 py-1 rounded-full">Live</span>
                : <span class="bg-slate-200 text-slate-500 text-xs font-semibold px-2 py-1 rounded-full">Coming soon</span>
              }
            </div>
            <p class="text-sm text-slate-600 mb-4">{ind.desc}</p>
            {ind.live
              ? <a href={ind.href} class="text-sm font-semibold text-orange-500 hover:text-orange-600 transition-colors">View page →</a>
              : <span class="text-sm text-slate-400">In progress</span>
            }
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTASection />
</Layout>
