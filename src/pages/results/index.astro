---
import Layout from '../../layouts/Layout.astro';
import CTASection from '../../components/ui/CTASection.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
---

<Layout
  title="Google Ads Case Studies | Clearbid"
  description="Google Ads case studies — real results for real businesses across Delhi NCR. [PLACEHOLDER: add case studies as they become available.]"
>
  <div class="container-site">
    <Breadcrumbs crumbs={[{ label: 'Home', href: '/' }, { label: 'Results' }]} />
  </div>

  <section class="bg-gradient-to-br from-blue-950 to-blue-800 text-white py-16 text-center">
    <div class="container-site max-w-3xl">
      <h1 class="text-4xl sm:text-5xl font-extrabold mb-4">Case Studies & Results</h1>
      <p class="text-blue-100 text-lg">
        Real results from real campaigns. [PLACEHOLDER: case studies will be published here as they are completed and client consent is obtained.]
      </p>
    </div>
  </section>

  <section class="py-20 text-center">
    <div class="container-site max-w-xl">
      <div class="text-5xl mb-6" aria-hidden="true">📈</div>
      <h2 class="text-2xl font-bold text-blue-900 mb-4">Case studies coming soon</h2>
      <p class="text-slate-600 mb-8">
        We're a new agency building our client base. Case studies will be published here as we complete engagements and receive client permission. Our commitment: every number on this page will be real.
      </p>
      <a href="/contact/" class="btn-primary inline-flex text-base px-8 py-4">
        Become a founding client
      </a>
    </div>
  </section>

  <CTASection />
</Layout>

<style>
  .btn-primary { display:inline-flex;align-items:center;justify-content:center;gap:0.5rem;padding:0.75rem 1.5rem;border-radius:0.5rem;background-color:#f97316;color:white;font-weight:600;transition:background-color 0.2s; }
  .btn-primary:hover { background-color:#ea580c; }
</style>
