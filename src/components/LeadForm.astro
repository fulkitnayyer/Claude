---
import { FORM, INDUSTRY_OPTIONS, AD_SPEND_RANGES } from '../config/site';

interface Props {
  variant?: 'full' | 'compact';
  heading?: string;
  formId?: string;
}

const { variant = 'full', heading, formId = `lead-form-${variant}` } = Astro.props;
---

<div class="lead-form">
  {heading && <h3 class="lead-form-heading">{heading}</h3>}

  <form id={formId} class="lead-form-el" novalidate data-endpoint={FORM.endpoint}>
    <div class="honeypot" aria-hidden="true">
      <label for={`${formId}-trap`}>Leave this empty</label>
      <input type="text" id={`${formId}-trap`} name="website_url_trap" tabindex="-1" autocomplete="off" />
    </div>

    <div class="form-grid form-grid-2">
      <div class="field">
        <label for={`${formId}-name`}>Name *</label>
        <input type="text" id={`${formId}-name`} name="name" required autocomplete="name" placeholder="Your name" />
      </div>
      <div class="field">
        <label for={`${formId}-business`}>Business name *</label>
        <input type="text" id={`${formId}-business`} name="business" required autocomplete="organization" placeholder="Your business name" />
      </div>
    </div>

    <div class="form-grid form-grid-2">
      <div class="field">
        <label for={`${formId}-city`}>City *</label>
        <input type="text" id={`${formId}-city`} name="city" required autocomplete="address-level2" placeholder="e.g. Pune" />
      </div>
      <div class="field">
        <label for={`${formId}-industry`}>Industry *</label>
        <select id={`${formId}-industry`} name="industry" required>
          <option value="">Select your industry</option>
          {INDUSTRY_OPTIONS.map(group => (
            <optgroup label={group.group}>
              {group.options.map(opt => <option value={opt}>{opt}</option>)}
            </optgroup>
          ))}
        </select>
      </div>
    </div>

    {variant === 'full' && (
      <div class="field">
        <label for={`${formId}-spend`}>Current monthly ad spend</label>
        <select id={`${formId}-spend`} name="ad_spend">
          <option value="">Select a range</option>
          {AD_SPEND_RANGES.map(r => <option value={r.value}>{r.label}</option>)}
        </select>
      </div>
    )}

    <div class="form-grid form-grid-2">
      <div class="field">
        <label for={`${formId}-whatsapp`}>WhatsApp number *</label>
        <div class="phone-input">
          <span class="phone-prefix">+91</span>
          <input
            type="tel"
            id={`${formId}-whatsapp`}
            name="whatsapp"
            required
            inputmode="numeric"
            autocomplete="tel-national"
            placeholder="98765 43210"
            pattern="[0-9]{10}"
            maxlength="10"
          />
        </div>
      </div>
      <div class="field">
        <label for={`${formId}-email`}>Email *</label>
        <input type="email" id={`${formId}-email`} name="email" required autocomplete="email" placeholder="you@business.com" />
      </div>
    </div>

    <div class="field">
      <label for={`${formId}-problem`}>What's going wrong right now?</label>
      <textarea
        id={`${formId}-problem`}
        name="problem"
        rows={variant === 'full' ? 3 : 2}
        placeholder="e.g. leads come in but nobody answers the phone"
      ></textarea>
    </div>

    <p class="field-error" id={`${formId}-error`} role="alert"></p>

    <button type="submit" class="btn btn-primary btn-block lead-submit">
      <span class="submit-text">Get my free account audit</span>
    </button>

    <p class="lead-form-fineprint muted">No obligation. We reply within one business day. We never share your details.</p>
  </form>
</div>

<script define:vars={{ formId }}>
  const form = document.getElementById(formId);
  if (form) {
    const errorEl = document.getElementById(`${formId}-error`);

    function showError(msg) {
      if (!errorEl) return;
      errorEl.textContent = msg;
      errorEl.classList.add('is-visible');
    }
    function clearError() {
      if (!errorEl) return;
      errorEl.textContent = '';
      errorEl.classList.remove('is-visible');
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      clearError();

      const data = new FormData(form);
      if (data.get('website_url_trap')) return;

      const whatsapp = String(data.get('whatsapp') || '');
      if (!/^[0-9]{10}$/.test(whatsapp)) {
        showError('Enter a valid 10-digit WhatsApp number.');
        return;
      }
      const email = String(data.get('email') || '');
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        showError('Enter a valid email address.');
        return;
      }

      const submitBtn = form.querySelector('.lead-submit');
      const submitText = form.querySelector('.submit-text');
      if (submitBtn) submitBtn.disabled = true;
      if (submitText) submitText.textContent = 'Sending…';

      try {
        const endpoint = form.dataset.endpoint || '/api/lead';
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: data,
        });
        if (res.ok) {
          window.location.href = '/thank-you/';
        } else {
          throw new Error('Server error');
        }
      } catch {
        showError("Something went wrong. Please WhatsApp us directly instead — it's faster anyway.");
        if (submitBtn) submitBtn.disabled = false;
        if (submitText) submitText.textContent = 'Get my free account audit';
      }
    });
  }
</script>

<style>
  .lead-form-heading {
    margin-bottom: 1.25rem;
  }

  .lead-form-el {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .phone-input {
    display: flex;
    align-items: stretch;
  }
  .phone-prefix {
    display: inline-flex;
    align-items: center;
    padding: 0 0.75rem;
    border: 1px solid color-mix(in srgb, var(--ink) 35%, transparent);
    border-right: none;
    border-top-left-radius: var(--radius);
    border-bottom-left-radius: var(--radius);
    background: color-mix(in srgb, var(--ink) 4%, var(--paper));
    font-size: var(--fs-sm);
    color: var(--muted);
  }
  .phone-input input {
    border-top-left-radius: 0;
    border-bottom-left-radius: 0;
    flex: 1;
    min-width: 0;
  }

  .lead-form-fineprint {
    font-size: var(--fs-xs);
    text-align: center;
  }
</style>
