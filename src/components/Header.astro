---
import { SITE, NAV_LINKS } from '../config/site';
---

<header class="sticky top-0 z-50 bg-white border-b border-slate-200 shadow-sm" id="site-header">
  <div class="container-site">
    <div class="flex items-center justify-between h-16 gap-4">

      <!-- Logo -->
      <a href="/" class="flex-shrink-0" aria-label="Clearbid — Home">
        <img
          src="/logo.svg"
          alt="Clearbid"
          width="160"
          height="35"
          class="h-8 w-auto"
          loading="eager"
        />
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden lg:flex items-center gap-1" aria-label="Main navigation">
        {NAV_LINKS.map(link => (
          <a
            href={link.href}
            class="px-3 py-2 text-sm font-medium text-slate-700 hover:text-blue-900 hover:bg-slate-50 rounded-md transition-colors"
          >
            {link.label}
          </a>
        ))}
      </nav>

      <!-- Desktop CTAs -->
      <div class="hidden lg:flex items-center gap-3 flex-shrink-0">
        <a
          href={`tel:${SITE.phoneRaw}`}
          class="flex items-center gap-2 text-sm font-semibold text-blue-900 hover:text-orange-500 transition-colors"
          onclick="window.dataLayer?.push({event:'call_click',location:'header'})"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1-9.4 0-17-7.6-17-17 0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1L6.6 10.8z"/>
          </svg>
          {SITE.phone}
        </a>
        <a href="/contact/" class="btn-primary text-sm px-4 py-2">
          Get a Free Audit
        </a>
      </div>

      <!-- Mobile: call + CTA + hamburger -->
      <div class="flex lg:hidden items-center gap-2">
        <a
          href={`tel:${SITE.phoneRaw}`}
          class="p-2 text-blue-900 hover:text-orange-500 transition-colors"
          aria-label="Call us"
          onclick="window.dataLayer?.push({event:'call_click',location:'header_mobile'})"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1-9.4 0-17-7.6-17-17 0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1L6.6 10.8z"/>
          </svg>
        </a>
        <a href="/contact/" class="btn-primary text-xs px-3 py-2">
          Free Audit
        </a>
        <button
          id="mobile-menu-btn"
          class="p-2 text-slate-700 hover:text-blue-900 transition-colors"
          aria-label="Open navigation menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg id="hamburger-icon" xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
          <svg id="close-icon" xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div
    id="mobile-menu"
    class="hidden lg:hidden border-t border-slate-200 bg-white"
    aria-hidden="true"
  >
    <nav class="container-site py-4 flex flex-col gap-1" aria-label="Mobile navigation">
      {NAV_LINKS.map(link => (
        <a
          href={link.href}
          class="px-4 py-3 text-sm font-medium text-slate-700 hover:text-blue-900 hover:bg-slate-50 rounded-md transition-colors"
        >
          {link.label}
        </a>
      ))}
      <div class="pt-3 border-t border-slate-100 mt-2">
        <a href="/contact/" class="btn-primary w-full justify-center">
          Get My Free Google Ads Audit
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const hamburger = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');

  btn?.addEventListener('click', () => {
    const isOpen = menu?.classList.contains('hidden') === false;
    menu?.classList.toggle('hidden');
    menu?.setAttribute('aria-hidden', isOpen ? 'true' : 'false');
    btn.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
    hamburger?.classList.toggle('hidden');
    closeIcon?.classList.toggle('hidden');
  });

  // Close menu on nav link click
  menu?.querySelectorAll('a').forEach(a => {
    a.addEventListener('click', () => {
      menu.classList.add('hidden');
      menu.setAttribute('aria-hidden', 'true');
      btn?.setAttribute('aria-expanded', 'false');
      hamburger?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
    });
  });
</script>
