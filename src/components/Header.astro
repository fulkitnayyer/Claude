---
import { SITE, NAV_LINKS } from '../config/site';
---

<header class="site-header" id="site-header">
  <div class="container header-row">
    <a href="/" class="wordmark" aria-label={`${SITE.name} — Home`}>
      <svg width="20" height="20" viewBox="0 0 32 32" aria-hidden="true">
        <path d="M16 7v9" stroke="currentColor" stroke-width="2.4" stroke-linecap="square"/>
        <path d="M16 16H9M16 16h7" stroke="currentColor" stroke-width="2.4" stroke-linecap="square"/>
        <path d="M9 16v6M23 16v6" stroke="currentColor" stroke-width="2.4" stroke-linecap="square"/>
        <rect x="7" y="23" width="4" height="4" fill="currentColor"/>
        <rect x="21" y="23" width="4" height="4" fill="#c0362c"/>
      </svg>
      <span>Structure</span>
    </a>

    <nav class="desktop-nav" aria-label="Main navigation">
      {NAV_LINKS.map(link => (
        <a href={link.href}>{link.label}</a>
      ))}
    </nav>

    <div class="header-ctas">
      <a href={`tel:${SITE.phoneRaw}`} class="header-call" aria-label={`Call ${SITE.phone}`}>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1-9.4 0-17-7.6-17-17 0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1L6.6 10.8z"/>
        </svg>
        <span>Call</span>
      </a>
      <a href="/contact/" class="btn btn-primary header-audit-btn">Get the free audit</a>
      <button id="menu-btn" class="menu-btn" aria-label="Open navigation menu" aria-expanded="false" aria-controls="mobile-menu">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <nav id="mobile-menu" class="mobile-menu" aria-label="Mobile navigation" aria-hidden="true">
    <div class="container">
      {NAV_LINKS.map(link => (
        <a href={link.href}>{link.label}</a>
      ))}
      <a href="/contact/" class="btn btn-primary btn-block" style="margin-top: 0.75rem;">Get the free audit</a>
    </div>
  </nav>
</header>

<script>
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    const open = menu?.classList.toggle('is-open');
    btn.setAttribute('aria-expanded', open ? 'true' : 'false');
    menu?.setAttribute('aria-hidden', open ? 'false' : 'true');
  });
  menu?.querySelectorAll('a').forEach(a => a.addEventListener('click', () => {
    menu.classList.remove('is-open');
    menu.setAttribute('aria-hidden', 'true');
    btn?.setAttribute('aria-expanded', 'false');
  }));
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--paper);
    border-bottom: 1px solid var(--rule);
  }

  .header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    height: 4.25rem;
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.15rem;
    letter-spacing: -0.01em;
    color: var(--ink);
    flex-shrink: 0;
  }

  .desktop-nav {
    display: none;
    align-items: center;
    gap: 0.1rem;
    flex: 1;
    justify-content: center;
    min-width: 0;
  }

  .desktop-nav a {
    font-family: var(--font-display);
    font-size: var(--fs-sm);
    font-weight: 550;
    padding: 0.5rem 0.65rem;
    color: var(--ink);
    white-space: nowrap;
  }
  .desktop-nav a:hover { color: var(--accent); }

  .header-ctas {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-shrink: 0;
  }

  .header-call {
    display: none;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-display);
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--ink);
  }
  .header-call:hover { color: var(--accent); }

  .header-audit-btn {
    padding: 0.6rem 1.1rem;
    font-size: var(--fs-xs);
  }

  .menu-btn {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    width: 2.5rem;
    height: 2.5rem;
    background: none;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
  }
  .menu-btn span {
    display: block;
    height: 1.5px;
    width: 1.1rem;
    margin-inline: auto;
    background: var(--ink);
  }

  .mobile-menu {
    display: none;
    border-top: 1px solid var(--rule);
    padding-block: 1rem 1.5rem;
  }
  .mobile-menu.is-open { display: block; }
  .mobile-menu a {
    display: block;
    font-family: var(--font-display);
    font-weight: 600;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--rule);
    color: var(--ink);
  }
  .mobile-menu a:last-of-type { border-bottom: none; }

  @media (min-width: 1024px) {
    .desktop-nav { display: flex; }
    .header-call { display: inline-flex; }
    .header-audit-btn { padding: 0.75rem 1.35rem; font-size: var(--fs-sm); }
    .menu-btn { display: none; }
    .mobile-menu { display: none !important; }
  }
</style>
