---
import { SITE } from '../config/site';
---

<footer class="bg-blue-950 text-slate-300">
  <div class="container-site py-12 lg:py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-12">

      <!-- Brand + NAP -->
      <div class="lg:col-span-2">
        <a href="/" aria-label="Clearbid — Home">
          <img src="/logo-dark.svg" alt="Clearbid" width="160" height="35" class="h-8 w-auto mb-4" loading="lazy" />
        </a>
        <p class="text-sm text-slate-400 mb-4 max-w-xs">
          Google Ads management for small and mid-sized businesses across Delhi NCR. More leads, less wasted spend.
        </p>
        <!-- NAP block for local SEO -->
        <address class="not-italic text-sm text-slate-400 space-y-1">
          <p class="font-semibold text-white">{SITE.name}</p>
          <p>{SITE.address}</p>
          <p>
            <a href={`tel:${SITE.phoneRaw}`} class="hover:text-white transition-colors" onclick="window.dataLayer?.push({event:'call_click',location:'footer'})">
              {SITE.phone}
            </a>
          </p>
          <p>
            <a href={`mailto:${SITE.email}`} class="hover:text-white transition-colors">
              {SITE.email}
            </a>
          </p>
        </address>
      </div>

      <!-- Services -->
      <div>
        <h3 class="text-sm font-semibold text-white uppercase tracking-wider mb-4">Services</h3>
        <ul class="space-y-2 text-sm">
          <li><a href="/services/google-ads-management/" class="hover:text-white transition-colors">Google Ads Management</a></li>
          <li><a href="/services/google-ads-audit/" class="hover:text-white transition-colors">Google Ads Audit</a></li>
          <li><a href="/services/campaign-setup/" class="hover:text-white transition-colors">Campaign Setup</a></li>
          <li><a href="/services/conversion-tracking/" class="hover:text-white transition-colors">Conversion Tracking</a></li>
          <li><a href="/pricing/" class="hover:text-white transition-colors">Pricing & Packages</a></li>
        </ul>
      </div>

      <!-- Company -->
      <div>
        <h3 class="text-sm font-semibold text-white uppercase tracking-wider mb-4">Company</h3>
        <ul class="space-y-2 text-sm">
          <li><a href="/about/" class="hover:text-white transition-colors">About</a></li>
          <li><a href="/results/" class="hover:text-white transition-colors">Case Studies</a></li>
          <li><a href="/blog/" class="hover:text-white transition-colors">Blog</a></li>
          <li><a href="/contact/" class="hover:text-white transition-colors">Contact</a></li>
          <li><a href="/locations/google-ads-agency-gurgaon/" class="hover:text-white transition-colors">Gurgaon</a></li>
          <li><a href="/locations/google-ads-agency-delhi/" class="hover:text-white transition-colors">Delhi</a></li>
          <li><a href="/locations/google-ads-agency-noida/" class="hover:text-white transition-colors">Noida</a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="mt-10 pt-8 border-t border-blue-900 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
      <p>&copy; {new Date().getFullYear()} {SITE.name}. All rights reserved.</p>
      <div class="flex items-center gap-4">
        <!-- [PLACEHOLDER: Google Partner badge — add once genuinely earned] -->
        <a href="/privacy-policy/" class="hover:text-white transition-colors">Privacy Policy</a>
        <a href="/terms/" class="hover:text-white transition-colors">Terms of Use</a>
      </div>
    </div>
  </div>
</footer>
