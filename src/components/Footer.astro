---
import { SITE } from '../config/site';
---

<footer class="site-footer tint-ink">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a href="/" class="wordmark" aria-label={`${SITE.name} — Home`}>
        <svg width="20" height="20" viewBox="0 0 32 32" aria-hidden="true">
          <path d="M16 7v9" stroke="currentColor" stroke-width="2.4" stroke-linecap="square"/>
          <path d="M16 16H9M16 16h7" stroke="currentColor" stroke-width="2.4" stroke-linecap="square"/>
          <path d="M9 16v6M23 16v6" stroke="currentColor" stroke-width="2.4" stroke-linecap="square"/>
          <rect x="7" y="23" width="4" height="4" fill="currentColor"/>
          <rect x="21" y="23" width="4" height="4" fill="#c0362c"/>
        </svg>
        <span>Structure</span>
      </a>
      <p class="muted footer-desc">
        Google Ads and Meta Ads management, run by a former Google Ads Account Strategist. For local businesses and for agencies who want it white-labelled.
      </p>
      <address>
        <p>{SITE.address}</p>
        <p><a href={`tel:${SITE.phoneRaw}`}>{SITE.phone}</a></p>
        <p><a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
      </address>
    </div>

    <div>
      <h3 class="footer-heading">Site</h3>
      <ul>
        <li><a href="/services/">Services</a></li>
        <li><a href="/industries/">Industries</a></li>
        <li><a href="/white-label/">White-label partners</a></li>
        <li><a href="/how-it-works/">How it works</a></li>
        <li><a href="/about/">About</a></li>
        <li><a href="/contact/">Contact</a></li>
      </ul>
    </div>

    <div>
      <h3 class="footer-heading">Get started</h3>
      <ul>
        <li><a href="/contact/">Free account audit</a></li>
        <li><a href={`https://wa.me/${SITE.whatsapp}`}>WhatsApp us</a></li>
        <li><a href="/privacy-policy/">Privacy policy</a></li>
        <li><a href="/terms/">Terms of use</a></li>
      </ul>
    </div>
  </div>

  <div class="container footer-bottom">
    <p class="muted">&copy; {new Date().getFullYear()} {SITE.legalName}. All rights reserved.</p>
    <p class="muted">Google Ads Certified · Meta Blueprint Certified</p>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: 3.5rem 2rem;
  }

  .footer-grid {
    display: grid;
    gap: 2.5rem;
    grid-template-columns: 1fr;
  }

  .footer-brand .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.15rem;
    color: var(--paper);
    margin-bottom: 1rem;
  }

  .footer-desc {
    max-width: 34ch;
    font-size: var(--fs-sm);
    margin-bottom: 1.25rem;
  }

  address {
    font-style: normal;
    font-size: var(--fs-sm);
    color: color-mix(in srgb, var(--paper) 80%, var(--ink));
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  address a:hover { color: var(--paper); text-decoration: underline; }

  .footer-heading {
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: color-mix(in srgb, var(--paper) 65%, var(--ink));
    margin-bottom: 1rem;
  }

  .footer-grid ul {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    font-size: var(--fs-sm);
  }
  .footer-grid a { color: color-mix(in srgb, var(--paper) 88%, var(--ink)); }
  .footer-grid a:hover { color: var(--paper); text-decoration: underline; }

  .footer-bottom {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid color-mix(in srgb, var(--paper) 18%, transparent);
    font-size: var(--fs-xs);
  }

  @media (min-width: 640px) {
    .footer-bottom { flex-direction: row; justify-content: space-between; }
  }

  @media (min-width: 768px) {
    .footer-grid { grid-template-columns: 1.4fr 1fr 1fr; }
  }
</style>
