---
interface Props {
  heading?: string;
  subtext?: string;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  bg?: 'dark' | 'light' | 'gradient';
}

const {
  heading = 'Ready to stop wasting money on Google Ads?',
  subtext = "Get a free audit and we'll show you exactly where your budget is going — and how to fix it.",
  primaryLabel = 'Get My Free Google Ads Audit',
  primaryHref = '/contact/',
  secondaryLabel = 'View Our Services',
  secondaryHref = '/services/',
  bg = 'dark',
} = Astro.props;
---

<section class={`py-16 lg:py-20 ${bg === 'dark' ? 'bg-blue-950' : bg === 'gradient' ? 'bg-gradient-to-br from-blue-950 to-blue-800' : 'bg-slate-50'}`}>
  <div class="container-site text-center">
    <h2 class={`text-3xl sm:text-4xl font-bold mb-4 ${bg !== 'light' ? 'text-white' : 'text-blue-900'}`}>
      {heading}
    </h2>
    <p class={`text-lg mb-8 max-w-2xl mx-auto ${bg !== 'light' ? 'text-blue-200' : 'text-slate-600'}`}>
      {subtext}
    </p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a href={primaryHref} class="btn-primary text-base px-8 py-4">
        {primaryLabel}
      </a>
      {secondaryLabel && (
        <a href={secondaryHref} class={bg !== 'light' ? 'btn-ghost text-base px-8 py-4' : 'btn-secondary text-base px-8 py-4'}>
          {secondaryLabel}
        </a>
      )}
    </div>
    <p class={`mt-4 text-sm ${bg !== 'light' ? 'text-blue-300' : 'text-slate-500'}`}>
      Free audit · No lock-in contracts · Cancel anytime
    </p>
  </div>
</section>
